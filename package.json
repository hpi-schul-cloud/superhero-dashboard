    "express-session": "^1.18.2",
    "fast-csv": "^5.0.7",
    "handlebars": "^4.7.7",
    "handlebars-layouts": "^3.1.4",
    "handlebars-wax": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "method-override": "^3.0.0",
    "moment": "^2.29.4",
    "moment-timezone": "^0.6.4",
    "morgan": "^1.10.1",
    "sanitize-html": "^2.17.4",
    "string-strip-html": "^13.7.5",
    "truncate-html": "^1.2.1",
    "url": "^0.11.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
