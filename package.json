{
  "name": "superhero-dashboard",
  "private": true,
  "scripts": {
    "build": "gulp",
    "watch:assets": "gulp watch",
    "start": "node ./bin/www",
    "watch": "node --watch ./bin/www",
    "debug": "node --inspect=0.0.0.0:9311 --watch ./bin/www",
    "lint": "eslint ./controllers ./helpers ./test ./api.js ./app.js ./static/scripts --fix",
    "test": "mocha 'test/**/*.{js,mjs}' --recursive --timeout 60000 --exit"
  },
  "engines": {
    "node": "24",
    "npm": "11"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
